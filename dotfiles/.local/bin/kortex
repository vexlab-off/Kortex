#!/bin/bash
set -eo pipefail

if [[ $# -eq 0 || "$1" == "--help" || "$1" == "-h" ]]; then
  /usr/share/omarchy/bin/omarchy "$@" 2>&1 | sed -e 's/Omarchy/Kortex/g' -e 's/omarchy/kortex/g'
  exit 0
fi

if [[ "$1" == "commands" ]]; then
  /usr/share/omarchy/bin/omarchy "$@" | sed -e 's/Omarchy/Kortex/g' -e 's/omarchy/kortex/g'
  exit 0
fi

exec /usr/share/omarchy/bin/omarchy "$@"
